{
  "schemaVersion": 1,
  "packageId": "Lan.RimWorldDevBridge",
  "adapterDirectory": "DevTools/BridgeAdapters",
  "adapterSource": "Source/RimWorldDevBridge/BridgeAdapterCatalog.cs",
  "buildEntrypoint": "DevTools/Package-RimWorldDevBridge.ps1",
  "validateEntrypoint": "DevTools/Test-RimWorldDevBridgePackage.ps1",
  "runtimeGuide": "DevTools/DEVBRIDGE_AGENT.md",
  "runtimeRecovery": {
    "bridgeNotActive": "bridge_not_active is recoverable. Activate the authorized managed-test instance and wait for bridge readiness before abandoning runtime verification.",
    "operation": "activate-and-wait",
    "readiness": "bridge",
    "canonicalAttachedReason": "attached_live_process_requires_operator",
    "canonicalReadyReason": "bridge_ready",
    "canonicalReadyPhase": "READY",
    "legacyAliases": {
      "attached_process_user_restart_required": "attached_live_process_requires_operator",
      "attached_process_requires_operator": "attached_live_process_requires_operator",
      "activation_ready": "bridge_ready",
      "BRIDGE_READY": "READY"
    },
    "responseFields": {
      "activationState": ["inactive", "activation_in_progress", "ready", "failed"],
      "waitFor": ["none", "bridge", "game", "map"],
      "recoverable": "boolean",
      "requiredAction": "string",
      "keepRunning": "boolean",
      "retrySafe": "boolean",
      "operatorActionRequired": "boolean",
      "nextAction": "string"
    },
    "automaticActivationOperations": ["discover", "context", "describe", "read", "repo context", "lease inspect"],
    "noAutomaticActivationOperations": ["call", "mutate", "cancel", "lease acquire", "lease renew", "lease release", "adapter reload"],
    "savePolicy": "none",
    "keepRunning": true,
    "startupTimeoutArgument": "--startup-timeout-ms",
    "progressIntervalArgument": "--progress-interval-ms",
    "maxLaunchAttemptsArgument": "--max-launch-attempts",
    "launchBackoffArgument": "--launch-backoff-ms",
    "deadManagedProcessPolicy": "verify identity, clear stale ownership, and retry within bounded limits; never return USER_RESTART_REQUIRED for a dead coordinator-owned PID",
    "restartCoalescing": {
      "requiresCompatiblePostcondition": true,
      "requiredIdentity": ["pid", "session", "lifecycleGeneration", "coreFingerprint", "adapterFingerprint"],
      "requiresForwardProgress": true,
      "staleWaitingForGameWatchdog": true,
      "allowsAuthorizedSupersession": true,
      "requiresFreshContextBeforeReady": true
    },
    "failureReasons": [
      "activation_in_progress",
      "activation_timeout",
      "managed_profile_missing",
      "sandbox_authorization_missing",
      "runtime_build_required",
      "deployment_mismatch",
      "managed_process_exited_before_ready",
      "stale_managed_ownership_recovered",
      "managed_launch_retrying",
      "managed_launch_failed",
      "bridge_handshake_timeout",
      "bridge_load_failed",
      "launch_profile_invalid",
      "attached_live_process_requires_operator",
      "bridge_ready"
    ],
    "lifecycleMetrics": ["lifecyclePending", "lifecycleCoalesced", "lifecycleDroppedStale"],
    "runtimeLane": {
      "compatibleReadConcurrency": true,
      "serializedOperations": ["restart", "save_load", "adapter_reload", "stateful_setup", "mutation", "lease_write"],
      "fair": true,
      "humanFeedbackNeverHoldsLane": true
    },
    "reviewQueue": {
      "commands": ["request", "list", "get", "resolve", "cancel", "wait", "checkpoint", "resume"],
      "categories": ["human_review", "human_approval", "hard_blocker"],
      "defaultResponseWindowMs": 60000,
      "awaitingState": "READY_AWAITING_HUMAN",
      "atomicUserRootPersistence": true,
      "deduplicated": true,
      "redacted": true,
      "neverAuthorizesMutation": true,
      "neverControlsAttachedProcess": true,
      "neverGrantsWriteLease": true
    }
  },
  "mcpAdapter": {
    "optional": true,
    "project": "DevTools/McpServer/RimWorldDevBridge.McpServer.csproj",
    "documentation": "DevTools/MCP_SERVER.md",
    "transport": "stdio",
    "runtime": ".NET 8",
    "canonicalClientOnly": true,
    "stdout": "MCP JSON-RPC only",
    "stderr": "sanitized diagnostics",
    "tools": [
      "ensure_bridge_ready",
      "get_bridge_status",
      "get_fresh_context",
      "list_bridge_capabilities",
      "run_read_only_query",
      "validate_owner_adapter",
      "request_managed_restart",
      "wait_for_runtime",
      "list_human_reviews",
      "create_human_review",
      "resolve_human_review",
      "get_resume_checkpoint"
    ],
    "gameplayMutation": false,
    "reviewNeverAuthorizesMutation": true,
    "requiresLocalApprovalForLifecycle": true
  }
}
