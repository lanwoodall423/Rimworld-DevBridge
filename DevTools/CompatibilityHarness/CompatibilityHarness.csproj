<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>RimWorldDevBridge.CompatibilityHarness</AssemblyName>
    <DevBridgeRequiresRimWorldReferences>true</DevBridgeRequiresRimWorldReferences>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="FixtureAdapter\**\*.cs" />
    <ProjectReference Include="..\..\Source\RimWorldDevBridge\RimWorldDevBridge.csproj" />
    <ProjectReference Include="FixtureAdapter\FixtureAdapter.csproj" ReferenceOutputAssembly="false" />
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(RimWorldHarmonyPath)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
